rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.role == 'ADMIN') || 
         (request.auth.token.role == 'super_admin') || 
         (request.auth.token.admin == true) ||
         (request.auth.token.email == 'king.khan648k@gmail.com') ||
         (request.auth.token.email == 'bannupakistani313@gmail.com') ||
         (request.auth.token.email != null && request.auth.token.email.matches('.*@admin\\.internal')));
    }

    // 1. User Profile Document
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // 2. User Folders Subcollection
      match /folders/{folderId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // 3. User Vault Media Metadata Subcollection
      match /vault_media/{mediaId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // 4. User Recordings Metadata Subcollection
      match /recordings/{recordingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 5. Cloud Recordings Collection (Guest and Registered user cloud recordings)
    match /cloud_recordings/{recordingId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid ||
          resource.data.anonymousAccountReference == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid ||
          request.resource.data.anonymousAccountReference == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid ||
          resource.data.anonymousAccountReference == request.auth.uid
        )
      );
    }

    // 6. Devices and Device Media Collection
    match /devices/{deviceId} {
      allow read, write: if isAuthenticated() || isAdmin();
      match /{allChildren=**} {
        allow read, write: if isAuthenticated() || isAdmin();
      }
    }

    // 7. Admin Records Collection & Subscriptions
    match /admin_records/{recordId} {
      allow read, write: if isAdmin();
    }

    // 8. Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read, write, create: if isAdmin();
    }

    // 9. In-App Announcements & System Updates
    match /system_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. License Keys / Activation Vouchers (No-Gmail Subscriptions)
    match /license_keys/{keyId} {
      // Allow single key verification and redemption, but prevent unauthorized users from listing/scraping all keys
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.isRedeemed != true || 
          resource.data.redeemedByUid == request.auth.uid
        )
      );
      allow create, delete: if isAdmin();
    }

    // Default deny rule for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
